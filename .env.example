# Docker Compose configuration. Copy to .env for local values; do not commit .env.
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
# Public origin of /api. The frontend proxies /api to the backend, so this is the frontend origin.
API_URL=http://localhost:3000

# Default: capture emails locally in Mailpit at http://localhost:8025.
# Replace these with your SMTP provider settings for real email delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Boardly <noreply@boardly.local>"

# Google Cloud OAuth client of type Web application.
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
