# The values are generated once on the Ansible server and reused on every deploy (see deploy.yml).
apiVersion: v1
kind: Secret
metadata:
  name: boardly-secrets
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  POSTGRES_PASSWORD: {{ postgres_password | to_json }}
  DATABASE_URL: {{ ('postgresql://boardly:' ~ postgres_password ~ '@postgres:5432/boardly?schema=public') | to_json }}
  JWT_SECRET: {{ jwt_secret | to_json }}
